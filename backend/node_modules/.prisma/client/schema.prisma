// ─────────────────────────────────────────────────────────────
// Prisma Schema — Food Delivery Backend
// Database: PostgreSQL
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  customer
  courier
  admin
}

// ✅ Extended for real delivery flow
// (old: pending | approved | rejected)
enum OrderStatus {
  pending
  approved
  rejected
  preparing
  picked_up
  on_the_way
  delivered
  cancelled
}

// ─────────────────────────────────────────────────────────────
// Category
// ─────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  icon      String? // emoji or icon name
  imageUrl  String? // optional category banner (Cloudinary URL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItems MenuItem[]

  @@index([name])
  @@map("categories")
}

// ─────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(customer)
  avatarUrl String? // ✅ renamed from `avatar` — Cloudinary URL
  fcmToken  String?  @unique // ✅ unique — prevents cross-device push leaks
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordersAsCustomer Order[]           @relation("CustomerOrders")
  ordersAsCourier  Order[]           @relation("CourierOrders")
  courierLocation  CourierLocation?
  locationHistory  LocationHistory[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// MenuItem  (a.k.a. "Food")
// ─────────────────────────────────────────────────────────────

model MenuItem {
  id            String  @id @default(uuid())
  name          String
  description   String?
  price         Float
  imageUrl      String? // ✅ renamed from `image` — Cloudinary URL
  imagePublicId String? // ✅ Cloudinary public_id (for deletion)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  rating      Float    @default(4.5)
  isPopular   Boolean  @default(false)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isPopular])
  @@map("menu_items")
}

// ─────────────────────────────────────────────────────────────
// Order
// ─────────────────────────────────────────────────────────────

model Order {
  id           String      @id @default(uuid())
  customerId   String
  courierId    String?
  status       OrderStatus @default(pending)
  totalAmount  Float
  deliveryLat  Float
  deliveryLng  Float
  deliveryAddr String?
  items        Json // keep for v1 (migrate to OrderItem later)

  paymentMethod String?   @default("cash") // "cash" | "chapa"
  paymentStatus String?   @default("pending") // "pending" | "paid" | "failed"
  txRef         String?   @unique // Chapa transaction reference
  paidAt        DateTime? // when payment confirmed
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer        User              @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  courier         User?             @relation("CourierOrders", fields: [courierId], references: [id], onDelete: SetNull)
  locationHistory LocationHistory[]
  orderItems      OrderItem[]

  @@index([customerId])
  @@index([courierId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
  @@map("orders")
}

// ─────────────────────────────────────────────────────────────
// OrderItem — optional, for future use (replaces Json items)
// ─────────────────────────────────────────────────────────────

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  price      Float // price at order time (snapshot)
  name       String // name snapshot
  imageUrl   String? // image snapshot

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────
// CourierLocation  (1:1 with User where role = courier)
// ─────────────────────────────────────────────────────────────

model CourierLocation {
  courierId String   @id
  lat       Float
  lng       Float
  heading   Float    @default(0)
  speed     Float    @default(0)
  accuracy  Float    @default(0)
  isOnline  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  courier User @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([isOnline])
  @@map("courier_locations")
}

// ─────────────────────────────────────────────────────────────
// LocationHistory
// ─────────────────────────────────────────────────────────────

model LocationHistory {
  id        String   @id @default(uuid())
  courierId String
  orderId   String?
  lat       Float
  lng       Float
  heading   Float    @default(0)
  speed     Float    @default(0)
  createdAt DateTime @default(now())

  courier User   @relation(fields: [courierId], references: [id], onDelete: Cascade)
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([courierId, createdAt])
  @@index([orderId, createdAt])
  @@map("location_history")
}
