{
  "expo": {
    "name": "Food Delivery",
    "slug": "fooddel-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "fooddel",
    "icon": "./src/public/logo.jpeg",
    "splash": {
      "image": "./src/public/logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fooddel.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We need access to your photos so you can upload a profile avatar and food images.",
        "NSCameraUsageDescription": "We need access to your camera so you can take a photo for your profile.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "foregroundImage": "./src/public/logo.jpeg",
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.fooddel.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./src/public/logo.jpeg",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-image-picker",
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Food Delivery to access your photos to upload food images.",
          "savePhotosPermission": "Allow Food Delivery to save photos."
        }
      ]
    ],
    "extra": {
      "apiUrl": {},
      "eas": {
        "projectId": "b460695d-8bad-4f93-8e51-7b208a44e61d"
      }
    }
  }
}
